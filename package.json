{
  "name": "uigraph",
  "version": "1.0.0",
  "description": "Generate UIGraph artifacts for a repository with a coding agent and edit them in a local UIGraph viewer.",
  "keywords": [
    "architecture",
    "diagrams",
    "mermaid",
    "claude",
    "documentation",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/uigraph-oss/uigraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uigraph-oss/uigraph.git"
  },
  "bugs": {
    "url": "https://github.com/uigraph-oss/uigraph/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "bin": {
    "uigraph": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:cli && pnpm build:viewer",
    "build:cli": "tsdown --config ./tsdown.config.ts",
    "build:viewer": "vite build --config ./vite.config.ts",
    "build:watch": "trap 'kill 0' EXIT; tsdown --config ./tsdown.config.ts --watch & NODE_OPTIONS=--max-old-space-size=8192 vite build --config ./vite.config.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p viewer/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@inquirer/prompts": "^8.7.3",
    "@uigraph/sdk": "^1.2.17",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "graphql": "^16.14.2",
    "open": "^11.0.4",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
